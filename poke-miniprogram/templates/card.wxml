<template name="card">
  <view class="card {{c.poke ? 'poke' : ''}}">
    <view class="chiprow">
      <view class="chip cat {{c.poke ? 'poke' : ''}}">{{c.poke ? '🌱 ' : ''}}{{c.cat}}</view>
      <view wx:for="{{c.tags}}" wx:key="*this" class="chip">{{item}}</view>
    </view>
    <view class="h3">{{c.title}}</view>
    <view class="summary">{{c.summary}}</view>
    <view class="meta">
      <text wx:if="{{c.time}}">🕒 {{c.time}}</text>
      <text wx:if="{{c.place}}">📍 {{c.place}}</text>
      <text wx:if="{{c.deadline}}" class="dl">⏰ {{c.deadline}}</text>
      <text wx:if="{{c.price}}">💰 {{c.price}}</text>
    </view>
    <view wx:if="{{c.pokeReason}}" class="pokereason">🌱 {{c.pokeReason}}</view>
    <view class="counts"><text class="hl">{{c.goN}}</text> 人想去 · <text class="hl">{{c.bdN}}</text> 人在找搭子</view>
    <view class="actions">
      <view class="btn btn-go {{c.go ? 'on' : ''}}" data-id="{{c.id}}" data-act="go" bindtap="onAct">{{c.go ? '✓ 已想去' : '想去 +1'}}</view>
      <view class="btn btn-buddy {{c.buddy ? 'on' : ''}}" data-id="{{c.id}}" data-act="buddy" bindtap="onAct">{{c.buddy ? '✓ 找搭子中' : '找搭子'}}</view>
    </view>
    <view wx:if="{{c.buddy}}" class="buddies">
      <block wx:if="{{c.names.length}}">一起的：<text wx:for="{{c.names}}" wx:key="*this" class="who">{{item}}</text></block>
      <block wx:else>你是第一个，等人来组队～</block>
      <view wx:if="{{c.go}}" class="attendwrap">
        <view class="btn btn-go {{c.attended ? 'btn-active' : ''}}" data-id="{{c.id}}" data-act="attend" bindtap="onAct">{{c.attended ? '✓ 已标记去过 → 去复盘' : '我去过了 / 标记完成'}}</view>
      </view>
    </view>
  </view>
</template>
