<template name="card">
  <view class="card {{c.poke ? 'poke' : ''}} {{c.enterClass || ''}}" hover-class="card-press" hover-stay-time="80" bindtap="onCardTap" data-id="{{c.id}}">
    <view class="card-row">
      <view class="card-thumb-wrap">
        <image class="card-thumb" src="{{c.thumbSrc}}" mode="aspectFill" />
      </view>
      <view class="card-main">
        <view class="gaprow" wx:if="{{c.gapReasons.length || c.insiderNote}}">
          <image wx:if="{{c.gapReasons.length}}" class="seal-icon" src="/assets/seal-dot.svg" mode="aspectFit"/>
          <view wx:for="{{c.gapReasons}}" wx:key="*this" class="gapchip gap-{{index}}">{{item}}</view>
          <view wx:if="{{c.insiderNote}}" class="gapchip gap-insider">内幕</view>
        </view>
        <view class="chiprow">
          <view class="chip cat {{c.poke ? 'poke' : ''}}" style="{{c.chipStyle}}">{{c.poke ? c.pokeChip + ' · ' : ''}}{{c.aiTopic || c.eventType || c.cat}}</view>
          <view wx:if="{{c.platform}}" class="chip plat">{{c.platform}}</view>
        </view>
        <view class="h3">{{c.title}}</view>
        <view class="summary card-summary">{{c.summary}}</view>
        <view class="meta card-meta">
          <view wx:if="{{c.time}}" class="meta-item"><text class="meta-val">{{c.time}}</text></view>
          <view wx:if="{{c.deadline}}" class="meta-item"><text class="meta-val dl dl-{{c.deadlineTier || 'unknown'}}">{{c.deadline}}</text></view>
        </view>
        <view class="card-more">查看详情 ›</view>
      </view>
    </view>
    <view class="actions" wx:if="{{c.url}}">
      <view class="btn btn-link btn-full" data-id="{{c.id}}" data-act="copylink" data-url="{{c.url}}" catchtap="onAct">复制原文链接</view>
    </view>
  </view>
</template>
