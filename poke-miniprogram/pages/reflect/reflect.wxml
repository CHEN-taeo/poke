<view class="page-section">
  <view class="page-section-title">复盘</view>
  <view class="page-section-sub">做完一件事，30 秒回答一个问题</view>
</view>

<view class="wrap tabpage" style="padding-top:0">
  <block wx:if="{{items.length}}">
    <view wx:for="{{items}}" wx:key="id" class="card">
      <view class="chiprow"><view class="chip cat">{{item.cat}}</view></view>
      <view class="h3">{{item.title}}</view>
      <view class="q">{{item.q}}</view>
      <textarea class="ta" data-id="{{item.id}}" bindinput="onInput" value="{{item.text}}"
        auto-height maxlength="-1" placeholder="随手写两句，给未来的自己" placeholder-style="color:#AEAEB2" />
      <view class="save-note">{{item.saved ? '已保存' : ''}}</view>
    </view>
  </block>
  <view wx:else class="empty">
    <view class="empty-illus"><view class="arc"></view><view class="dot"></view></view>
    <view class="empty-title">还没有可复盘的事</view>
    <view class="small">做完一件事后点「标记完成」，这里会出现一个小问题</view>
  </view>
</view>
