.wrap { padding: 28rpx; }
.lead { font-size: 26rpx; color: #9aa3b2; line-height: 1.7; margin-bottom: 24rpx; }
.field { margin-bottom: 20rpx; }
.label { display: block; font-size: 24rpx; color: #6b7280; margin-bottom: 8rpx; }
.inp, .ta { width: 100%; background: #222633; border: 1px solid #2c3140; color: #eef1f7; border-radius: 18rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.ta { min-height: 320rpx; margin-bottom: 20rpx; }
.primary { background: linear-gradient(135deg, #7c5cff, #37e0c6); color: #fff; border-radius: 24rpx; padding: 26rpx; text-align: center; font-size: 30rpx; font-weight: 700; }
.hint { font-size: 23rpx; color: #6b7280; line-height: 1.7; margin-top: 24rpx; padding: 20rpx; border: 1px dashed #2c3140; border-radius: 16rpx; }
