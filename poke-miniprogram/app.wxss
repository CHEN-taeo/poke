page {
  background: #0f1117;
  color: #eef1f7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
view, text { box-sizing: border-box; }

.wrap { padding: 28rpx 28rpx 60rpx; }

/* header (today page) */
.hd {
  padding: 36rpx 32rpx 28rpx;
  background: radial-gradient(120% 100% at 0% 0%, rgba(124,92,255,.30), transparent 60%),
              radial-gradient(120% 100% at 100% 0%, rgba(55,224,198,.22), transparent 55%),
              #0f1117;
  border-bottom: 1px solid #2c3140;
}
.brand { display: flex; align-items: center; }
.logo {
  width: 72rpx; height: 72rpx; border-radius: 22rpx; margin-right: 20rpx;
  background: linear-gradient(135deg, #7c5cff, #37e0c6);
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.brand .title { font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand .tag { font-size: 22rpx; color: #9aa3b2; margin-top: 4rpx; }
.datebar { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 26rpx; }
.datebar .d { font-size: 24rpx; color: #9aa3b2; }
.datebar .d .b { color: #eef1f7; font-size: 28rpx; font-weight: 600; }
.gear {
  background: #222633; border: 1px solid #2c3140; color: #9aa3b2;
  border-radius: 14rpx; padding: 12rpx 22rpx; font-size: 24rpx; line-height: 1;
}

/* lead + section titles */
.lead { font-size: 24rpx; color: #9aa3b2; margin: 6rpx 8rpx 24rpx; line-height: 1.7; }
.lead .em { color: #37e0c6; }
.sec-title { display: flex; align-items: center; margin: 30rpx 8rpx 18rpx; font-size: 24rpx; color: #9aa3b2; font-weight: 600; }
.sec-title .n { background: #7c5cff; color: #fff; border-radius: 12rpx; font-size: 22rpx; padding: 2rpx 14rpx; margin-right: 14rpx; }

/* card */
.card { background: #1a1d27; border: 1px solid #2c3140; border-radius: 28rpx; padding: 28rpx; margin-bottom: 24rpx; }
.card.poke { border: 1px solid rgba(255,180,84,.4); background: linear-gradient(180deg, rgba(255,180,84,.08), #1a1d27); }
.chiprow { display: flex; flex-wrap: wrap; align-items: center; margin-bottom: 16rpx; }
.chip { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; background: #222633; color: #9aa3b2; border: 1px solid #2c3140; margin: 0 12rpx 8rpx 0; }
.chip.cat { background: rgba(124,92,255,.18); color: #bda9ff; border-color: transparent; }
.chip.cat.poke { background: rgba(255,180,84,.18); color: #ffb454; }
.h3 { font-size: 34rpx; font-weight: 600; line-height: 1.4; margin-bottom: 12rpx; }
.summary { font-size: 27rpx; color: #9aa3b2; line-height: 1.65; margin-bottom: 18rpx; }
.meta { display: flex; flex-wrap: wrap; font-size: 24rpx; color: #6b7280; margin-bottom: 22rpx; }
.meta text { margin-right: 28rpx; }
.meta .dl { color: #ffb454; font-weight: 600; }
.pokereason { font-size: 23rpx; color: #ffb454; line-height: 1.6; margin-bottom: 16rpx; }
.counts { font-size: 24rpx; color: #9aa3b2; margin-bottom: 18rpx; }
.counts .hl { color: #37e0c6; font-weight: 700; }
.actions { display: flex; }
.btn {
  flex: 1; border-radius: 22rpx; padding: 22rpx; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  background: #222633; color: #eef1f7; border: 1px solid #2c3140; margin-right: 18rpx;
}
.btn:last-child { margin-right: 0; }
.btn.on.btn-go { background: linear-gradient(135deg, #7c5cff, #9b7bff); color: #fff; border-color: transparent; }
.btn.on.btn-buddy { background: linear-gradient(135deg, #ff6b9d, #ff8fb3); color: #fff; border-color: transparent; }
.btn-active { opacity: .7; }
.buddies { margin-top: 22rpx; border-top: 1px dashed #2c3140; padding-top: 20rpx; font-size: 24rpx; color: #9aa3b2; }
.who { display: inline-block; background: #222633; border: 1px solid #2c3140; border-radius: 999rpx; padding: 8rpx 20rpx; margin: 6rpx 10rpx 0 0; font-size: 23rpx; }
.attendwrap { margin-top: 20rpx; }
.attendwrap .btn { margin-right: 0; }

/* empty */
.empty { text-align: center; color: #6b7280; padding: 120rpx 40rpx; font-size: 28rpx; line-height: 2; }
.empty .big { font-size: 90rpx; margin-bottom: 16rpx; }
.empty .small { font-size: 24rpx; }

/* reflect */
.q { background: #222633; border: 1px solid #2c3140; border-radius: 20rpx; padding: 22rpx; margin: 18rpx 0; font-size: 27rpx; color: #cdd3df; line-height: 1.6; }
.ta, .inp {
  width: 100%; background: #222633; border: 1px solid #2c3140; color: #eef1f7;
  border-radius: 18rpx; padding: 20rpx; font-size: 28rpx;
}
.save-note { font-size: 23rpx; color: #37e0c6; margin-top: 10rpx; min-height: 26rpx; }

/* operator */
.kpis { display: flex; flex-wrap: wrap; margin: 14rpx 0 24rpx; }
.kpi { width: 50%; padding: 8rpx; box-sizing: border-box; }
.kpi-inner { background: #1a1d27; border: 1px solid #2c3140; border-radius: 24rpx; padding: 24rpx; }
.kpi .v { font-size: 50rpx; font-weight: 800; color: #37e0c6; }
.kpi .l { font-size: 22rpx; color: #9aa3b2; margin-top: 6rpx; }
.hint { font-size: 23rpx; color: #9aa3b2; line-height: 1.8; background: #1a1d27; border: 1px dashed #2c3140; border-radius: 20rpx; padding: 22rpx; margin: 16rpx 0; }
.hint .b { color: #eef1f7; }
.opitem { background: #1a1d27; border: 1px solid #2c3140; border-radius: 20rpx; padding: 22rpx 24rpx; margin-bottom: 18rpx; display: flex; justify-content: space-between; align-items: center; }
.opitem .t { font-size: 27rpx; }
.opitem .s { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }
.opitem .ops { display: flex; }
.opitem .e { background: #222633; border: 1px solid #2c3140; color: #9aa3b2; border-radius: 14rpx; padding: 10rpx 18rpx; font-size: 23rpx; margin-left: 12rpx; }
.opitem .del { color: #ff6b9d; }
.primary { background: linear-gradient(135deg, #7c5cff, #37e0c6); color: #fff; border-radius: 24rpx; padding: 26rpx; font-size: 30rpx; font-weight: 700; text-align: center; margin-top: 12rpx; }
.ghost { background: #222633; color: #9aa3b2; border: 1px solid #2c3140; border-radius: 22rpx; padding: 22rpx; font-size: 26rpx; text-align: center; margin-top: 18rpx; }

/* edit overlay */
.mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.6); z-index: 50; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #0f1117; border-top-left-radius: 36rpx; border-top-right-radius: 36rpx; border: 1px solid #2c3140; max-height: 88vh; overflow-y: auto; padding: 32rpx 28rpx 50rpx; z-index: 51; }
.sheet .st { font-size: 36rpx; font-weight: 700; margin-bottom: 8rpx; }
.sheet .ssub { color: #9aa3b2; font-size: 24rpx; margin-bottom: 24rpx; line-height: 1.6; }
.field { margin-bottom: 22rpx; }
.field .label { display: block; font-size: 24rpx; color: #9aa3b2; margin-bottom: 10rpx; }
.field-row { display: flex; }
.field-row .field { flex: 1; margin-right: 18rpx; }
.field-row .field:last-child { margin-right: 0; }
.picker { background: #222633; border: 1px solid #2c3140; border-radius: 18rpx; padding: 20rpx; font-size: 28rpx; }

/* toast */
.toast { position: fixed; bottom: 180rpx; left: 50%; transform: translateX(-50%); background: #fff; color: #111; padding: 18rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 600; z-index: 99; }
