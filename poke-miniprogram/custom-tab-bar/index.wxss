.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
  background: rgba(255, 255, 255, 0.58);
  border-top: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 -6rpx 32rpx rgba(42, 46, 55, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.tabinner {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  min-height: 108rpx;
  padding: 8rpx 12rpx 12rpx;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx 14rpx;
  color: rgba(42, 46, 55, 0.42);
  position: relative;
  min-height: 88rpx;
}
.tab.on { color: #6B8CAE; }
.tab.on::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  width: 28rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #6B8CAE;
}
.tab-add { flex: 0 0 120rpx; padding-bottom: 6rpx; }
.tab-add.on::after { display: none; }
.add-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #8BA9C4 0%, #6B8CAE 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 10rpx 32rpx rgba(107, 140, 174, 0.38), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  margin-top: -28rpx;
}
.icon {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 6rpx;
}
.txt { font-size: 20rpx; line-height: 1.2; }
