# 复制为 .env 后填写。全部可留空——留空则用「规则引擎」离线跑，零依赖。

# 服务端口
PORT=5700

# 采集模式：real（真实投喂）| wechaty（旧版微信钩子，见 AUTONOMOUS.md）
INGEST_MODE=real

# ===== 自动采集（东华官网等）=====
AUTO_INGEST=1
AUTO_INTERVAL_MIN=15

# ===== 微信群聊 · 方案 B：wechat-cli（微信 4.x，无需降级，推荐）=====
# 安装：powershell -ExecutionPolicy Bypass -File scripts/install-wechat-cli.ps1
# WECHAT_CLI=1
# WECHAT_CLI_HUB=1              # 只监听「文件传输助手」— 群消息转发到这里即可（半自动、主号可用）
# ROOM_WHITELIST=兼职群,二手群  # 或直读指定群（群名与微信列表完全一致）
# WECHAT_CLI_POLL_SEC=30

# ===== AI（可选）=====
# DeepSeek（OpenAI 兼容，中文好且便宜）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== wechaty 模式相关（INGEST_MODE=wechaty 时生效）=====
# 桌面版微信钩子（Windows）。需自行安装：npm i wechaty wechaty-puppet-xp
WECHATY_PUPPET=wechaty-puppet-xp
# 只采集这些群（群名，英文逗号分隔；留空=所有群）。强烈建议白名单，避免乱采+隐私问题。
ROOM_WHITELIST=
# 是否也采集“监听到的”链接消息（公众号文章转发）：1 开 0 关
INGEST_URLS=1
